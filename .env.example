# =========================
# Airflow Admin User
# =========================
AIRFLOW_UID=50000
AIRFLOW_WWW_USER_USERNAME=admin
AIRFLOW_WWW_USER_PASSWORD=your_admin_password

# =========================
# Airflow Security
# =========================
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your_fernet_key_here

# =========================
# Main PostgreSQL Connection
# Used by the postgres container itself
# =========================
POSTGRES_CONN_USERNAME=postgres
POSTGRES_CONN_PASSWORD=your_postgres_password
POSTGRES_CONN_HOST=postgres
POSTGRES_CONN_PORT=5432

# =========================
# Airflow Metadata Database
# Stores DAG runs, logs, task states, etc.
# =========================
METADATA_DATABASE_NAME=airflow_metadata
METADATA_DATABASE_USERNAME=airflow_meta_user
METADATA_DATABASE_PASSWORD=your_metadata_db_password

# =========================
# Celery Result Backend
# Stores Celery task results
# =========================
CELERY_BACKEND_NAME=airflow_celery
CELERY_BACKEND_USERNAME=celery_user
CELERY_BACKEND_PASSWORD=your_celery_password

# =========================
# ELT / Data Warehouse Database
# Where transformed YouTube data is stored
# =========================
ELT_DATABASE_NAME=youtube_dw
ELT_DATABASE_USERNAME=elt_user
ELT_DATABASE_PASSWORD=your_elt_password

# =========================
# YouTube API
# =========================
API_KEY=your_youtube_api_key
CHANNEL_HANDLE=@your_channel_handle